[MASTER]

# Disable false-positive PyQt6 import errors in venv
extension-pkg-allow-list=PyQt6

# Per-file ignores
[TYPECHECK]
ignored-modules=PyQt6

[MESSAGES CONTROL]
# Per-file: main_window.py
# R0902: too-many-instance-attributes - needed for GUI state
# R0903: too-few-public-methods - internal widget using signals
# R0915: too-many-statements - central event handlers
# W0212: protected-access - intentional access to ConfigParser internals
# E0611: no-name-in-module - false positive for PyQt6 in venv